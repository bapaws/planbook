  local_json = File.expand_path("play-api.json", __dir__)
  json_key =
    ENV["SUPPLY_JSON_KEY_PATH"] ||
    ENV["PLAY_STORE_JSON_KEY"] ||
    (File.exist?(local_json) ? local_json : nil) ||
    "/Users/zhangminchao/Desktop/TimeCal/Sign/lunar-clone-491812-u4-a2cc78736289.json"
  json_key_file(json_key)
  package_name("com.bapaws.planbook")
end

